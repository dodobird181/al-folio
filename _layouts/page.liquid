---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  {% unless page.hide_navbar or page.external_content %}
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">{{ page.description }}</p>
    </header>
  {% endunless %}

  <article>
    {% if page.external_content %}
      <div id="external-content-loading">Loading...</div>
      <div id="external-content"></div>
      <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
      <script>
        fetch("{{ page.external_content }}")
          .then(r => r.text())
          .then(md => {
            document.getElementById("external-content-loading").remove();
            document.getElementById("external-content").innerHTML = marked.parse(md);
          })
          .catch(() => {
            document.getElementById("external-content-loading").textContent = "Failed to load content.";
          });
      </script>
    {% else %}
      {{ content }}
    {% endif %}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
