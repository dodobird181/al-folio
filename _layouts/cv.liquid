---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {{ page.title }}
      {% if page.cv_pdf %}
        <a
          {% if page.cv_pdf contains '://' %}
            href="{{ page.cv_pdf }}"
          {% else %}
            href="{{ page.cv_pdf | prepend: 'assets/pdf/' | relative_url }}"
          {% endif %}
          class="float-right"
          download="Samuel_Morris_Resume.pdf"
        >
          <i class="fa-solid fa-download"></i>
        </a>
      {% endif %}
    </h1>
    {% if page.description %}
      <p class="post-description">{{ page.description }}</p>
    {% endif %}
  </header>

  {% if page.cv_pdf %}
    {% if page.cv_pdf contains '://' %}
      {% assign cv_pdf_url = page.cv_pdf %}
    {% else %}
      {% assign cv_pdf_url = page.cv_pdf | prepend: 'assets/pdf/' | relative_url %}
    {% endif %}
    <embed
      src="{{ cv_pdf_url }}"
      type="application/pdf"
      width="100%"
      style="height: calc(100vh - 140px); display: block;"
    />
  {% endif %}
</div>
